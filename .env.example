APP_ENV=local
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
S3_DOCUMENT_BUCKET=rag-ops-guard-docs-local
S3_VECTOR_BUCKET=rag-ops-guard-vectors-local
S3_VECTOR_INDEX=ops-knowledge-v1
VECTOR_DIMENSION=1024
VECTOR_DISTANCE_METRIC=cosine
RETRIEVAL_TOP_K=8
RETRIEVAL_CONTEXT_K=5
CHUNK_TOKENS=400
CHUNK_OVERLAP=60
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen35-0.8b-rag
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_TOP_K=20
LLM_MIN_P=0.0
LLM_PRESENCE_PENALTY=1.5
LLM_REPEAT_PENALTY=1.0
EMBEDDING_BASE_URL=http://localhost:8081/v1
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIMENSION=1024
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=rag-ops-guard-local
RAG_DEBUG=false
