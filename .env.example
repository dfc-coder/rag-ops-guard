APP_ENV=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
FLOCI_HOST_PORT=4566
LLAMA_GEN_HOST_PORT=8080
LLAMA_EMBED_HOST_PORT=8081
LLAMA_RERANK_HOST_PORT=8082
S3_DOCUMENT_BUCKET=rag-ops-guard-docs-local
S3_VECTOR_BUCKET=rag-ops-guard-vectors-local
S3_VECTOR_INDEX=ops-knowledge-v1
VECTOR_DIMENSION=1024
VECTOR_DISTANCE_METRIC=cosine
RETRIEVAL_TOP_K=20
RETRIEVAL_CONTEXT_K=4
RETRIEVAL_DOMAIN_MIN_RELEVANCE=0.5
RETRIEVAL_MIN_RELEVANCE=0.5
CHUNK_TOKENS=400
CHUNK_OVERLAP=60
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen35-2b-rag
LLM_ANALYSIS_MAX_TOKENS=128
LLM_ANSWER_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_TOP_K=20
LLM_MIN_P=0.0
LLM_PRESENCE_PENALTY=1.5
LLM_REPEAT_PENALTY=1.0
LLAMA_CTX_SIZE=8192
LLAMA_PARALLEL=1
EMBEDDING_BASE_URL=http://localhost:8081/v1
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIMENSION=1024
RERANKER_BASE_URL=http://localhost:8082
RERANKER_MODEL=qwen3-reranker-0.6b
RERANKER_TIMEOUT_SECONDS=90
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=rag-ops-guard-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
RAG_DEBUG=false
