APP_ENV=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_DOCUMENT_BUCKET=rag-ops-guard-docs-local
S3_VECTOR_BUCKET=rag-ops-guard-vectors-local
S3_VECTOR_INDEX=ops-knowledge-v1
VECTOR_DIMENSION=1024
VECTOR_DISTANCE_METRIC=cosine
RETRIEVAL_TOP_K=8
RETRIEVAL_CONTEXT_K=5
CHUNK_TOKENS=400
CHUNK_OVERLAP=60
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen3-4b-rag
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.0
EMBEDDING_BASE_URL=http://localhost:8081/v1
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIMENSION=1024
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=rag-ops-guard-local
LANGSMITH_API_KEY=
RAG_DEBUG=false
